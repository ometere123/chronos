# ===== BACKEND =====

DATABASE_URL=postgres://user:pass@db.supabase.co:5432/postgres
NODE_ENV=development
PORT=3001

# ===== FRONTEND =====

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TIMELOCK_VAULT=0xe5e264d2822af13bcdacf83d6c3eecf1b55a966d

# Circle User-Controlled Wallets App ID (Console > Web3 Services > User-Controlled Wallets).
# Needed for the email-OTP sign-up flow's Web SDK to initialize. Also requires an SMTP relay
# configured in the same Console section for OTP emails to send.
NEXT_PUBLIC_CIRCLE_APP_ID=your_circle_app_id

# ===== DEPLOYMENT =====

VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_vercel_project_id

